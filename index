<!DOCTYPE html>
<html lang="zh-TW">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>政大富翁 - 像素復古版</title>
    <style>
        /* --- 像素復古風顏色與字體變數 --- */
        :root {
            --bg-dark: #111827; /* 深色背景 */
            --panel-bg: #1F2937; /* 面板背景 */
            --text-main: #F3F4F6; /* 主文字顏色 */
            --text-highlight: #FBBF24; /* 強調/黃色文字 */
            --border-color: #4B5563; /* 邊框顏色 */
            --board-bg: #374151; /* 棋盤區背景 */
            --cell-bg: #F9FAFB; /* 格子背景 */
            --pixel-border: 4px solid var(--border-color); /* 粗邊框模擬像素感 */
        }

        body {
            font-family: 'Courier New', Courier, monospace, 'Microsoft JhengHei'; /* 使用等寬字體增加復古感 */
            background-color: var(--bg-dark);
            color: var(--text-main);
            margin: 0;
            padding: 0;
            display: flex;
            flex-direction: column;
            height: 100vh;
            overflow: hidden;
            /* 讓所有圖片/元素邊緣保持銳利 (Pixelated) */
            image-rendering: pixelated; 
        }

        /* --- 復古 UI 面板組件 --- */
        .retro-panel {
            background-color: var(--panel-bg);
            border: var(--pixel-border);
            box-shadow: 4px 4px 0px 0px #000000; /* 硬陰影創造立體方塊感 */
            padding: 15px;
            color: var(--text-main);
        }

        h2, h3 {
            color: var(--text-highlight);
            margin-top: 0;
            border-bottom: 2px dashed var(--border-color);
            padding-bottom: 10px;
        }

        button {
            background-color: var(--text-highlight);
            color: var(--bg-dark);
            border: 4px solid #D97706;
            font-family: inherit;
            font-weight: bold;
            font-size: 1rem;
            padding: 8px 16px;
            cursor: pointer;
            box-shadow: inset -4px -4px 0px rgba(0,0,0,0.2);
            transition: transform 0.1s;
        }

        button:active {
            transform: scale(0.95);
            box-shadow: inset 4px 4px 0px rgba(0,0,0,0.2);
        }

        button:disabled {
            background-color: #6B7280;
            border-color: #4B5563;
            cursor: not-allowed;
        }

        select, input {
            background-color: var(--bg-dark);
            color: var(--text-highlight);
            border: 2px solid var(--border-color);
            padding: 5px;
            font-family: inherit;
            font-size: 1rem;
        }

        /* --- 版面配置 --- */
        #game-container {
            display: flex;
            width: 100%;
            height: 100%;
        }

        /* 左側：遊戲棋盤區 (2D 俯視) */
        #board-wrapper {
            flex: 3;
            display: flex;
            justify-content: center;
            align-items: center;
            background-color: var(--bg-dark);
            position: relative;
            overflow: hidden;
        }

        #board {
            position: relative;
            width: 900px;
            height: 900px;
            background-color: var(--board-bg);
            border: var(--pixel-border);
        }

        .cell {
            position: absolute;
            width: 60px;
            height: 60px;
            box-sizing: border-box;
            border: 2px solid var(--border-color);
            background-color: var(--cell-bg);
            color: #111;
            display: flex;
            flex-direction: column;
            justify-content: center;
            align-items: center;
            font-size: 0.65rem;
            font-weight: bold;
            text-align: center;
        }

        /* 玩家像素棋子 */
        .player-token {
            position: absolute;
            width: 24px;
            height: 24px;
            border: 2px solid #000;
            border-radius: 4px; /* 微微圓角但保持方塊感 */
            z-index: 10;
            display: flex;
            justify-content: center;
            align-items: center;
            font-weight: bold;
            font-size: 12px;
            color: white;
            transition: all 0.3s steps(4); /* 移動時有逐格動畫感 */
            box-shadow: 2px 2px 0px rgba(0,0,0,0.5);
        }

        /* 右側：UI 資訊與操作區 */
        #ui-wrapper {
            flex: 1;
            min-width: 350px;
            padding: 20px;
            display: flex;
            flex-direction: column;
            gap: 20px;
            border-left: var(--pixel-border);
            background-color: var(--panel-bg);
            overflow-y: auto;
        }

        /* 對話與文字提示框 */
        #log-box {
            flex-grow: 1;
            background-color: var(--bg-dark);
            border: 2px solid var(--border-color);
            padding: 10px;
            overflow-y: auto;
            font-size: 0.85rem;
            line-height: 1.5;
        }

        #quote-box {
            background-color: #374151;
            border-left: 4px solid var(--text-highlight);
            padding: 10px;
            font-style: italic;
            margin-bottom: 10px;
            display: none;
        }

        /* Modal 彈窗 (初始設定、銀行、樂透) */
        .modal-overlay {
            position: fixed;
            top: 0; left: 0; width: 100%; height: 100%;
            background: rgba(0,0,0,0.85);
            display: flex;
            justify-content: center;
            align-items: center;
            z-index: 100;
        }
    </style>
</head>
<body>
<!-- ================= 彈窗區 (Modals) ================= -->
    
    <!-- 1. 初始設定畫面 -->
    <div id="setup-modal" class="modal-overlay">
        <div class="retro-panel" style="width: 450px;">
            <h2>🏫 政大富翁 - 入學設定</h2>
            <div style="display: flex; justify-content: space-between; margin-bottom: 10px;">
                <label>玩家人數:</label>
                <select id="player-count" onchange="updatePlayerSelectors()">
                    <option value="2">2 人</option>
                    <option value="3">3 人</option>
                    <option value="4">4 人</option>
                </select>
            </div>
            <div style="display: flex; justify-content: space-between; margin-bottom: 10px;">
                <label>初始資金:</label>
                <select id="init-money">
                    <option value="50000">50,000 元</option>
                    <option value="100000" selected>100,000 元</option>
                    <option value="200000">200,000 元</option>
                </select>
            </div>
            <div style="display: flex; justify-content: space-between; margin-bottom: 15px;">
                <label>遊戲時間:</label>
                <select id="max-turns">
                    <option value="30">1 個月 (30 回合)</option>
                    <option value="90">3 個月 (90 回合)</option>
                    <option value="180">6 個月 (180 回合)</option>
                </select>
            </div>
            <div id="player-setup-area" style="border-top: 2px dashed var(--border-color); padding-top: 15px;">
                <!-- 玩家選單將由 JS 動態生成 -->
            </div>
            <button onclick="startGame()" style="width: 100%; margin-top: 20px;">🎲 開始遊戲</button>
        </div>
    </div>

    <!-- 2. 銀行系統 (出納組) -->
    <div id="bank-modal" class="modal-overlay" style="display: none;">
        <div class="retro-panel" style="width: 350px;">
            <h2>🏦 總務處出納組</h2>
            <p>存款餘額: <span id="bank-deposit" style="color: #10B981; font-weight: bold;">$0</span></p>
            <p>手邊現金: <span id="bank-cash" style="color: var(--text-highlight); font-weight: bold;">$0</span></p>
            <input type="number" id="bank-amount" placeholder="請輸入金額" style="width: 100%; box-sizing: border-box; margin-bottom: 15px;">
            <div style="display: flex; gap: 10px; margin-bottom: 10px;">
                <button onclick="handleBankAction('deposit')" style="flex: 1;">存入</button>
                <button onclick="handleBankAction('withdraw')" style="flex: 1; background-color: #EF4444; border-color: #B91C1C;">提款</button>
            </div>
            <button onclick="closeModal('bank-modal')" style="width: 100%; background-color: #6B7280; border-color: #4B5563;">離開</button>
        </div>
    </div>

    <!-- 3. 大樂透系統 -->
    <div id="lotto-modal" class="modal-overlay" style="display: none;">
        <div class="retro-panel" style="width: 350px;">
            <h2>🎰 財政大樂透</h2>
            <p>每注 $1,000。每 10 回合開獎一次！</p>
            <p>目前累積獎金: <span id="lotto-pool-display" style="color: #10B981; font-weight: bold;">$50,000</span></p>
            <input type="number" id="lotto-number" min="1" max="49" placeholder="請選擇 1-49 的幸運號碼" style="width: 100%; box-sizing: border-box; margin-bottom: 15px;">
            <button onclick="buyLottery()" style="width: 100%; margin-bottom: 10px;">購買彩券</button>
            <button onclick="closeModal('lotto-modal')" style="width: 100%; background-color: #6B7280; border-color: #4B5563;">放棄購買</button>
        </div>
    </div>

    <!-- 4. 卡片背包系統 -->
    <div id="bag-modal" class="modal-overlay" style="display: none;">
        <div class="retro-panel" style="width: 400px; max-height: 80vh; overflow-y: auto;">
            <h2>🎒 隨身背包 (卡片)</h2>
            <div id="card-list" style="display: flex; flex-direction: column; gap: 10px; margin-bottom: 15px;">
                <!-- 擁有的卡片會顯示在這裡 -->
            </div>
            <button onclick="closeModal('bag-modal')" style="width: 100%; background-color: #6B7280; border-color: #4B5563;">關閉背包</button>
        </div>
    </div>

    <!-- ================= 主遊戲版面 ================= -->
    <div id="game-container">
        
        <!-- 左側：棋盤區 -->
        <div id="board-wrapper">
            <div id="board">
                <!-- 75 格地圖與玩家棋子將由 JS 生成 -->
            </div>
        </div>

        <!-- 右側：UI 資訊與操作區 -->
        <div id="ui-wrapper">
            
            <!-- 玩家資訊面板 -->
            <div id="players-panel" style="display: flex; flex-direction: column; gap: 10px;">
                <!-- JS 動態生成玩家卡片 -->
            </div>

            <!-- 專屬對話框 -->
            <div id="quote-box"></div>

            <!-- 遊戲文字紀錄 -->
            <div id="log-box"></div>

            <!-- 操作面板 -->
            <div class="retro-panel">
                <div style="margin-bottom: 10px; font-weight: bold;">
                    目前輪到: <span id="turn-indicator" style="color: var(--text-highlight);">準備中</span>
                </div>
                <div style="font-size: 0.85rem; margin-bottom: 15px; color: #9CA3AF;">
                    回合: <span id="global-turn">1</span> / <span id="total-turns">30</span> 
                    (開獎倒數: <span id="lotto-cd">10</span>)
                </div>
                <div style="display: flex; gap: 10px;">
                    <button id="btn-roll" onclick="rollDice()" style="flex: 2;">🎲 擲骰子</button>
                    <button id="btn-bag" onclick="openBag()" style="flex: 1; background-color: #3B82F6; border-color: #1D4ED8;">🎒 背包</button>
                </div>
            </div>

        </div>
    </div>

    <!-- ================= JavaScript 邏輯開始 ================= -->
    <script>
    // ================= 1. 核心資料庫 (對應 Excel 企劃書) =================

        // 角色與天賦設定
        const roleData = {
            law: { 
                name: "國考戰神", color: "#3B82F6", 
                quotes: { buy: "程序合法，謝謝指教。", pay: "這違反比例原則，我要上訴！", win: "這筆財產沒有法律爭議。", bankrupt: "我要申請破產保護..." },
                talentDesc: "法源依據：需付過路費或遭陷害時，15%機率免責免罰。"
            },
            comm: { 
                name: "爆肝網美", color: "#EC4899", 
                quotes: { buy: "採光超讚，買來拍 Vlog！", pay: "能發限動幫你業配抵債嗎？", win: "感謝乾爹贊助！", bankrupt: "我的流量...變現失敗..." },
                talentDesc: "社群影響：開局自帶300點，點數商店購買卡片八折。"
            },
            soc: { 
                name: "社運實踐", color: "#10B981", 
                quotes: { buy: "這筆預算能化為社會影響力！", pay: "當作贊助你的專案啦。", win: "專案資金終於有著落了！", bankrupt: "資源重分配失敗..." },
                talentDesc: "預算精算：升級房屋時，享有 20% 的折扣。"
            },
            bus: { 
                name: "華爾街狼", color: "#F59E0B", 
                quotes: { buy: "看這 ROI，絕對穩賺不賠。", pay: "這點沉沒成本不算什麼。", win: "現金流才是王道。", bankrupt: "槓桿開太大，斷頭了..." },
                talentDesc: "投資金童：初始資金加一萬，銀行存錢利息+0.5%。"
            },
            art: { 
                name: "百年詩人", color: "#8B5CF6", 
                quotes: { buy: "千金難買這獨特的人文底蘊。", pay: "金錢不過是世俗的枷鎖，拿去。", win: "浪漫的餽贈。", bankrupt: "窮得只剩下詩了..." },
                talentDesc: "人文底蘊：購得特定山區建築，過路費大幅加成。"
            }
        };

        // 75 格特殊地標配置
        const specialCells = {
            0: {name: "政大正門\n(起點)", type: "start"},
            8: {name: "樂活館\n(醫院)", type: "hospital"},
            15: {name: "靠北政大\n(命運)", type: "destiny"},
            18: {name: "出納組\n(銀行)", type: "bank"},
            25: {name: "財政大樂透", type: "lotto"},
            35: {name: "體育館\n(監獄)", type: "prison"},
            42: {name: "政大交流版\n(機會)", type: "chance"},
            45: {name: "集英樓\n(商店)", type: "shop"},
            55: {name: "八角亭\n(魔法屋)", type: "magic"},
            65: {name: "出納組\n(銀行)", type: "bank"},
            70: {name: "財政大樂透", type: "lotto"}
        };

        const propertyNames = [
            "志希樓", "果夫樓", "研究大樓", "學思樓", "逸仙樓", "資訊大樓", "新聞館", 
            "大智樓", "大勇樓", "大仁樓", "綜院南棟", "綜院北棟", "井塘樓", "社資中心", 
            "商學院", "法學院", "傳播學院", "道藩樓", "百年樓", "季陶樓", "研創中心"
        ];

        // 產生 75 格環狀地圖座標 (20 x 19 的空心矩形)
        const mapData = [];
        let propIndex = 0;
        
        // 上邊 (0~19)
        for(let i=0; i<20; i++) createCell(i, i, 0);
        // 右邊 (20~37)
        for(let i=1; i<=18; i++) createCell(mapData.length, 19, i);
        // 下邊 (38~56)
        for(let i=18; i>=0; i--) createCell(mapData.length, i, 19);
        // 左邊 (57~74)
        for(let i=18; i>=1; i--) createCell(mapData.length, 0, i);

        function createCell(id, x, y) {
            let cell = specialCells[id];
            if (!cell) {
                // 如果不是特殊格，就分配地產或點數格
                if (id % 5 === 0) {
                    cell = { name: "點數格\n(+30點)", type: "points", points: 30 };
                } else {
                    let pName = propertyNames[propIndex % propertyNames.length];
                    propIndex++;
                    cell = { name: pName, type: "property", price: 1000 + (id * 30), owner: null, level: 0 };
                    cell.rent = cell.price * 0.4;
                }
            }
            cell.id = id;
            cell.x = x;
            cell.y = y;
            mapData.push(cell);
        }

        // ================= 2. 系統變數與初始化 =================
        let players = [];
        let currentPlayerIndex = 0;
        let globalTurn = 1;
        let maxGlobalTurns = 30;
        let lottoPool = 50000;
        
        const boardEl = document.getElementById('board');
        const logBox = document.getElementById('log-box');
        const quoteBox = document.getElementById('quote-box');

        function logMessage(msg) {
            logBox.innerHTML += `<div style="margin-bottom:8px; border-bottom:1px dashed #4B5563; padding-bottom:8px;">${msg}</div>`;
            logBox.scrollTop = logBox.scrollHeight;
        }

        function showQuote(text) {
            quoteBox.innerText = `「${text}」`;
            quoteBox.style.display = 'block';
            setTimeout(() => { quoteBox.style.display = 'none'; }, 3000);
        }

        // 動態生成設定選單
        function updatePlayerSelectors() {
            const count = document.getElementById('player-count').value;
            const area = document.getElementById('player-setup-area');
            area.innerHTML = '';
            const options = Object.keys(roleData).map(k => `<option value="${k}">${roleData[k].name}</option>`).join('');
            for(let i=1; i<=count; i++) {
                area.innerHTML += `
                    <div style="display: flex; justify-content: space-between; margin-bottom: 10px;">
                        <label>玩家 ${i} 角色:</label>
                        <select id="p${i}-role">${options}</select>
                    </div>`;
            }
            if(count >= 2) document.getElementById('p2-role').selectedIndex = 1;
            if(count >= 3) document.getElementById('p3-role').selectedIndex = 2;
            if(count >= 4) document.getElementById('p4-role').selectedIndex = 3;
        }
        updatePlayerSelectors();

        // 正式開始遊戲
        function startGame() {
            const count = parseInt(document.getElementById('player-count').value);
            const initMoney = parseInt(document.getElementById('init-money').value);
            maxGlobalTurns = parseInt(document.getElementById('max-turns').value);
            document.getElementById('total-turns').innerText = maxGlobalTurns;
            
            players = [];
            for(let i=1; i<=count; i++) {
                let rKey = document.getElementById(`p${i}-role`).value;
                let role = roleData[rKey];
                players.push({
                    id: i, name: `P${i}(${role.name})`, roleKey: rKey, role: role,
                    money: rKey === 'bus' ? initMoney + 10000 : initMoney,
                    bank: 0, points: rKey === 'comm' ? 330 : 30,
                    pos: 0, color: role.color, status: 'normal', lottoNumber: null,
                    inventory: [] // 背包系統預備
                });
            }

            document.getElementById('setup-modal').style.display = 'none';
            renderBoard();
            createPlayers();
            updateUI();
            logMessage("🎓 歡迎來到政大！像素版遊戲正式開始！");
        }

        // ================= 3. 繪製 2D 像素地圖 =================
        function renderBoard() {
            boardEl.innerHTML = '';
            const cellSize = 60; // 對應 CSS 的 .cell 大小
            
            mapData.forEach(cell => {
                const el = document.createElement('div');
                el.className = 'cell';
                el.style.left = (cell.x * cellSize) + 'px';
                el.style.top = (cell.y * cellSize) + 'px';
                
                // 像素風顏色配置
                if(cell.type === 'start') el.style.backgroundColor = '#FECACA'; // 紅
                else if(cell.type === 'bank' || cell.type === 'shop') el.style.backgroundColor = '#A7F3D0'; // 綠
                else if(cell.type === 'lotto' || cell.type === 'points') el.style.backgroundColor = '#FEF08A'; // 黃
                else if(cell.type === 'hospital' || cell.type === 'prison' || cell.type === 'magic') el.style.backgroundColor = '#E5E7EB'; // 灰
                else if(cell.type === 'chance' || cell.type === 'destiny') el.style.backgroundColor = '#DDD6FE'; // 紫
                
                el.id = 'cell-' + cell.id;
                
                let content = `<span>${cell.name.replace('\n', '<br>')}</span>`;
                if(cell.type === 'property') content += `<br><span style="color:#D97706">$${cell.price}</span>`;
                el.innerHTML = content;
                boardEl.appendChild(el);
            });
        }

        function createPlayers() {
            players.forEach(p => {
                const token = document.createElement('div');
                token.className = 'player-token';
                token.id = 'token-' + p.id;
                token.style.backgroundColor = p.color;
                token.innerText = p.id;
                boardEl.appendChild(token);
            });
            updatePlayerPositions();
        }

        function updatePlayerPositions() {
            const cellSize = 60;
            players.forEach(p => {
                if (p.status === 'bankrupt') return;
                const cell = mapData[p.pos];
                const token = document.getElementById('token-' + p.id);
                // 讓同一格的玩家稍微錯開
                const pxOffset = (p.id % 2 === 0 ? 15 : -5);
                const pyOffset = (p.id > 2 ? 15 : -5);
                token.style.left = (cell.x * cellSize + 15 + pxOffset) + 'px';
                token.style.top = (cell.y * cellSize + 15 + pyOffset) + 'px';
            });
        }

        function updateUI() {
            const pPanel = document.getElementById('players-panel');
            pPanel.innerHTML = '';
            players.forEach((p, index) => {
                if(p.status === 'bankrupt') return;
                let activeStyle = index === currentPlayerIndex ? `border-color: ${p.color}; box-shadow: 0 0 10px ${p.color};` : '';
                pPanel.innerHTML += `
                    <div class="retro-panel" style="${activeStyle}">
                        <div style="font-weight:bold; color:${p.color}; font-size:1.1rem; border-bottom:1px solid #4B5563; padding-bottom:5px; margin-bottom:5px;">${p.name}</div>
                        <div>現金: <span style="color:var(--text-highlight)">$${p.money}</span></div>
                        <div>存款: <span style="color:#10B981">$${p.bank}</span></div>
                        <div>點數: ${p.points}</div>
                    </div>`;
            });

            let p = players[currentPlayerIndex];
            document.getElementById('turn-indicator').innerText = p.name;
            document.getElementById('btn-roll').disabled = (p.status !== 'normal');
            
            let lottoCd = 10 - (globalTurn % 10);
            if(lottoCd === 10) lottoCd = 0;
            document.getElementById('lotto-cd').innerText = lottoCd;
        }

        function openModal(id) { document.getElementById(id).style.display = 'flex'; }
        function closeModal(id) { document.getElementById(id).style.display = 'none'; }
        // ================= 4. 核心遊戲迴圈 =================
        
        function rollDice() {
            const p = players[currentPlayerIndex];
            document.getElementById('btn-roll').disabled = true;
            document.getElementById('btn-bag').disabled = true; // 骰骰子後不能開背包
            
            const dice = Math.floor(Math.random() * 6) + 1;
            logMessage(`🎲 <span style="color:${p.color}">${p.name}</span> 擲出了 ${dice} 點。`);
            
            let steps = 0;
            const moveInterval = setInterval(() => {
                p.pos++;
                if(p.pos >= mapData.length) {
                    p.pos = 0;
                    p.money += 3000;
                    logMessage(`🏛️ ${p.name} 經過正門，領取生活費 <span style="color:var(--text-highlight)">$3,000</span>。`);
                }
                updatePlayerPositions();
                steps++;
                
                if(steps >= dice) {
                    clearInterval(moveInterval);
                    setTimeout(() => handleCellAction(p), 400);
                }
            }, 250); // 配合像素風，移動速度稍微調慢一點點，更有逐格感
        }

        function handleCellAction(p) {
            const cell = mapData[p.pos];
            logMessage(`📍 ${p.name} 停在 【${cell.name.replace('\n', '')}】`);

            if(cell.type === 'property') {
                if(!cell.owner) {
                    if(p.money >= cell.price) {
                        if(confirm(`【${cell.name.replace('\n', '')}】是空地。\n價格: $${cell.price}\n\n要購買嗎？`)) {
                            p.money -= cell.price;
                            cell.owner = p.id;
                            // 改變地產格子的邊框顏色代表擁有權
                            document.getElementById('cell-' + cell.id).style.border = `4px solid ${p.color}`;
                            logMessage(`🏠 ${p.name} 買下了 ${cell.name.replace('\n', '')}。`);
                            showQuote(p.role.quotes.buy);
                        }
                    } else {
                        logMessage(`❌ ${p.name} 現金不足，無法購買 ${cell.name.replace('\n', '')}。`);
                    }
                } else if(cell.owner !== p.id) {
                    const owner = players.find(x => x.id === cell.owner);
                    let rent = cell.rent * (cell.level + 1);
                    
                    // 法學院天賦判定：15% 機率免責
                    let avoidRent = false;
                    if(p.roleKey === 'law' && Math.random() < 0.15) {
                        avoidRent = true;
                        alert("⚖️ 法源依據護體！\n成功找出法律漏洞，免責免罰！");
                        logMessage(`⚖️ ${p.name} 找出法律漏洞，免付過路費！`);
                    }

                    if(!avoidRent) {
                        alert(`踩到 ${owner.name} 的地盤！\n需支付過路費: $${rent}`);
                        p.money -= rent;
                        owner.money += rent;
                        logMessage(`💸 ${p.name} 支付 $${rent} 給 ${owner.name}。`);
                        showQuote(p.role.quotes.pay);
                        checkBankrupt(p);
                    }
                } else {
                    // 自己地盤升級
                    if(cell.level < 4) {
                        let cost = cell.price * 0.5;
                        if(p.roleKey === 'soc') cost = cost * 0.8; // 社科院打折 20%
                        if(confirm(`是否花費 $${cost} 升級【${cell.name.replace('\n', '')}】? (目前 Lv.${cell.level})`)) {
                            if(p.money >= cost) {
                                p.money -= cost;
                                cell.level++;
                                logMessage(`🔨 ${p.name} 將 ${cell.name.replace('\n', '')} 升級至 Lv.${cell.level}。`);
                                // 更新畫面上顯示的金額與等級
                                let el = document.getElementById('cell-' + cell.id);
                                el.innerHTML = `<span>${cell.name.replace('\n', '<br>')}</span><br><span style="color:#D97706">Lv.${cell.level}</span>`;
                            } else {
                                alert("現金不足！");
                            }
                        }
                    }
                }
            } else if(cell.type === 'points') {
                p.points += cell.points;
                logMessage(`🎁 ${p.name} 獲得 ${cell.points} 點數！`);
            } else if(cell.type === 'bank') {
                document.getElementById('bank-cash').innerText = `$${p.money}`;
                document.getElementById('bank-deposit').innerText = `$${p.bank}`;
                openModal('bank-modal');
                return; // 等待 Modal 關閉再結算回合
            } else if(cell.type === 'lotto') {
                document.getElementById('lotto-pool-display').innerText = `$${lottoPool}`;
                openModal('lotto-modal');
                return;
            } else {
                // 醫院、監獄、機會命運等模組預留
                logMessage(`✨ 觸發特殊事件！(進階功能開發中)`);
            }

            endTurn();
        }

        // ================= 5. 銀行與大樂透操作 =================
        function handleBankAction(action) {
            let p = players[currentPlayerIndex];
            let amt = parseInt(document.getElementById('bank-amount').value);
            if(isNaN(amt) || amt <= 0) return alert("請輸入有效金額");
            
            if(action === 'deposit' && p.money >= amt) {
                p.money -= amt; p.bank += amt;
                logMessage(`🏦 ${p.name} 存入 $${amt}。`);
            } else if(action === 'withdraw' && p.bank >= amt) {
                p.money += amt; p.bank -= amt;
                logMessage(`🏦 ${p.name} 提款 $${amt}。`);
            } else {
                alert("餘額不足！"); return;
            }
            document.getElementById('bank-cash').innerText = `$${p.money}`;
            document.getElementById('bank-deposit').innerText = `$${p.bank}`;
            updateUI();
        }

        function buyLottery() {
            let p = players[currentPlayerIndex];
            let num = parseInt(document.getElementById('lotto-number').value);
            if(isNaN(num) || num < 1 || num > 49) return alert("請選擇 1~49 號！");
            if(p.money < 1000) return alert("現金不足 $1,000！");
            
            p.money -= 1000;
            lottoPool += 1000;
            p.lottoNumber = num;
            logMessage(`🎰 ${p.name} 購買了樂透號碼 [${num}]。`);
            closeModal('lotto-modal');
            // closeModal 裡面已經綁定了 endTurn()
        }

        // ================= 6. 回合結算與破產機制 =================
        function checkBankrupt(p) {
            if(p.money < 0 && (p.money + p.bank) >= 0) {
                alert("現金為負，自動將存款轉為現金抵債！");
                p.money += p.bank; p.bank = 0;
            }
            if(p.money < 0) {
                // 強制變賣土地 (7折)
                let properties = mapData.filter(c => c.owner === p.id);
                if(properties.length > 0) {
                    alert(`現金不足！強制變賣所有土地抵債！`);
                    properties.forEach(c => {
                        p.money += Math.floor(c.price * 0.7);
                        c.owner = null; 
                        c.level = 0;
                        let el = document.getElementById('cell-' + c.id);
                        el.style.border = '2px solid var(--border-color)';
                        el.innerHTML = `<span>${c.name.replace('\n', '<br>')}</span><br><span style="color:#D97706">$${c.price}</span>`;
                    });
                    logMessage(`🔥 ${p.name} 變賣了所有房產斷尾求生！`);
                }
                
                if(p.money < 0) {
                    p.status = 'bankrupt';
                    alert(`💀 ${p.name} 正式破產！`);
                    showQuote(p.role.quotes.bankrupt);
                    logMessage(`💀 ${p.name} 破產退學！`);
                    document.getElementById('token-' + p.id).style.display = 'none';
                }
            }
        }

        function endTurn() {
            // 尋找下一個未破產的玩家
            let activePlayers = players.filter(p => p.status !== 'bankrupt');
            if(activePlayers.length <= 1) {
                alert(`🏆 遊戲結束！恭喜 ${activePlayers[0].name} 成為政大首富！`);
                return;
            }

            do {
                currentPlayerIndex = (currentPlayerIndex + 1) % players.length;
            } while(players[currentPlayerIndex].status === 'bankrupt');

            // 如果所有人輪完一圈，進入下一回合
            if(currentPlayerIndex === 0) {
                globalTurn++;
                
                // 結算銀行利息
                players.forEach(p => {
                    if(p.status !== 'bankrupt' && p.bank > 0) {
                        let rate = p.roleKey === 'bus' ? 0.055 : 0.05; // 商院 5.5%，其餘 5%
                        p.bank += Math.floor(p.bank * rate);
                    }
                });

                // 樂透開獎 (每 10 回合)
                if(globalTurn % 10 === 0) {
                    let winNum = Math.floor(Math.random() * 49) + 1;
                    logMessage(`🎉 財政大樂透開獎！本期號碼：<span style="color:var(--text-highlight)">[${winNum}]</span>，總獎金 $${lottoPool}`);
                    let winners = players.filter(p => p.lottoNumber === winNum && p.status !== 'bankrupt');
                    if(winners.length > 0) {
                        let prize = Math.floor(lottoPool / winners.length);
                        winners.forEach(w => {
                            w.money += prize;
                            logMessage(`🏆 恭喜 ${w.name} 中獎，獲得 $${prize}！`);
                            showQuote(w.role.quotes.win);
                        });
                        lottoPool = 50000; // 重置獎金池
                    } else {
                        logMessage(`沒有人中獎，獎金累積至下期！`);
                    }
                    players.forEach(p => p.lottoNumber = null);
                }

                if(globalTurn > maxGlobalTurns) {
                    alert("遊戲時間到！開始結算總資產！");
                    // 這裡可以寫結算所有土地+現金的邏輯
                    return;
                }
            }
            
            updateUI();
            document.getElementById('btn-bag').disabled = false; // 換人後允許開背包
        }

        // ================= 7. 預留：卡片背包系統 =================
        function openBag() {
            let p = players[currentPlayerIndex];
            let bagUI = document.getElementById('card-list');
            bagUI.innerHTML = '';
            
            if(p.inventory.length === 0) {
                bagUI.innerHTML = '<p style="color:#9CA3AF;">背包裡空空如也...</p>';
            } else {
                p.inventory.forEach(card => {
                    bagUI.innerHTML += `<button style="margin-bottom: 5px;">使用 ${card.name}</button>`;
                });
            }
            openModal('bag-modal');
        }

    </script>
</body>
